# Default 8080; use 8081 if the instant-payments-js Docker container already binds 8080.
PORT=8081

# Required DynamoDB connectivity (use http://localhost:18000 when tests or CLI run on the host against compose below)
DYNAMODB_ENDPOINT=http://localhost:18000
DYNAMODB_REGION=eu-west-1
DYNAMODB_CLIENTTYPE=high-level
DYNAMODB_TABLENAME=JS_InstantPayments

# Required by spec: inclusive range 3600..31536000
DYNAMODB_IDEMPOTENCY_TTL_SECONDS=2592000

# Optional (LATEST default). Tests may use TRIM_HORIZON.
DYNAMODB_STREAMS_ITERATOR_TYPE=LATEST

# CreateTable + TTL + seed on startup (default true). Set false when table is managed by IaC.
DYNAMODB_INITIALIZE_ENABLED=true

# Health endpoints /health and /actuator/health (default true)
HEALTH_ENABLED=true

# OpenAPI + Swagger UI (default true in development, false in production)
SWAGGER_ENABLED=true

