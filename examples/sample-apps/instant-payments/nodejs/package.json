  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "worker:local": "bash scripts/run-worker-local.sh",
    "scripts:create-table": "node scripts/create-table.mjs",
    "scripts:enable-ttl": "node scripts/enable-ttl.mjs",
