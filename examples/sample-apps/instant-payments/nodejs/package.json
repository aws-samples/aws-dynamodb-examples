    "@aws-sdk/util-dynamodb": "^3.996.4",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "newman": "^6.2.2",
    "pino-pretty": "^13.1.3",
